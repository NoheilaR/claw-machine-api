{% extends 'base.html.twig' %}
{% block title %}OVERLOAD - Dashboard{% endblock %}

{% block body %}
    <style>
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .dashboard-header h1 {
            font-size: 3em;
            font-weight: 700;
            margin-bottom: 12px;
            background: linear-gradient(135deg, #ffffff 0%, #a1a1aa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .dashboard-header p {
            color: var(--text-muted);
            font-size: 1.05em;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 24px;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: rgba(139, 92, 246, 0.4);
            box-shadow: var(--glow-purple);
        }

        .stat-label {
            font-size: 0.85em;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 2.2em;
            font-weight: 700;
            color: var(--purple);
            line-height: 1;
        }

        .stat-unit {
            font-size: 0.5em;
            color: var(--text-secondary);
            font-weight: 400;
        }

        /* Main Content Grid */
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 40px;
        }

        .section {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 28px;
        }

        .section-title {
            font-size: 1.5em;
            font-weight: 600;
            margin-bottom: 20px;
            color: var(--text-primary);
        }

        /* Top 3 Players */
        .podium {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 16px;
            margin-top: 20px;
        }

        .podium-place {
            flex: 1;
            max-width: 150px;
            text-align: center;
            position: relative;
        }

        .podium-place.first {
            order: 2;
        }

        .podium-place.second {
            order: 1;
        }

        .podium-place.third {
            order: 3;
        }

        .podium-rank {
            width: 50px;
            height: 50px;
            margin: 0 auto 12px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5em;
            font-weight: 700;
        }

        .podium-place.first .podium-rank {
            background: linear-gradient(135deg, #ffd700, #ffa500);
            color: #000;
            width: 60px;
            height: 60px;
            font-size: 1.8em;
        }

        .podium-place.second .podium-rank {
            background: linear-gradient(135deg, #c0c0c0, #808080);
            color: #000;
        }

        .podium-place.third .podium-rank {
            background: linear-gradient(135deg, #cd7f32, #8b4513);
            color: #fff;
        }

        .podium-bar {
            background: linear-gradient(180deg, rgba(139, 92, 246, 0.3), rgba(139, 92, 246, 0.1));
            border: 1px solid rgba(139, 92, 246, 0.4);
            border-radius: 8px 8px 0 0;
            padding: 20px 12px;
            margin-top: 12px;
        }

        .podium-place.first .podium-bar {
            height: 180px;
            background: linear-gradient(180deg, rgba(139, 92, 246, 0.5), rgba(139, 92, 246, 0.2));
        }

        .podium-place.second .podium-bar {
            height: 140px;
        }

        .podium-place.third .podium-bar {
            height: 100px;
        }

        .podium-name {
            font-size: 0.95em;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 8px;
            word-break: break-word;
        }

        .podium-score {
            font-size: 1.4em;
            font-weight: 700;
            color: var(--purple);
        }

        /* Recent Scores */
        .recent-score {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.1);
        }

        .recent-score:last-child {
            border-bottom: none;
        }

        .recent-score:hover {
            background: rgba(139, 92, 246, 0.05);
            border-radius: 8px;
        }

        .recent-player {
            font-weight: 600;
            color: var(--text-primary);
        }

        .recent-score-value {
            font-weight: 700;
            color: var(--purple);
        }

        .recent-time {
            font-size: 0.85em;
            color: var(--text-muted);
        }

        /* Quick Actions */
        .actions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .action-card {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.15);
            border-radius: 12px;
            padding: 24px;
            text-decoration: none;
            color: var(--text-primary);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .action-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 12px;
            padding: 1px;
            background: linear-gradient(135deg, var(--accent-color, #8b5cf6), rgba(236, 72, 153, 0.3));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .action-card:hover::before {
            opacity: 1;
        }

        .action-card:hover {
            transform: translateY(-4px);
            border-color: var(--accent-color);
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.2);
        }

        .action-card:nth-child(1) { --accent-color: #8b5cf6; }
        .action-card:nth-child(2) { --accent-color: #ec4899; }
        .action-card:nth-child(3) { --accent-color: #3b82f6; }
        .action-card:nth-child(4) { --accent-color: #06b6d4; }

        .action-title {
            font-size: 1.3em;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .action-desc {
            font-size: 0.9em;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        .action-arrow {
            margin-top: 12px;
            color: var(--accent-color);
            font-size: 1.2em;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }

        @media (max-width: 968px) {
            .main-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 640px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .podium {
                flex-direction: column;
                align-items: stretch;
            }

            .podium-place {
                max-width: 100%;
                order: initial !important;
            }

            .podium-bar {
                height: auto !important;
                min-height: 80px;
            }
        }
    </style>

    <div class="container">
        <div class="dashboard-header">
            <h1 class="title-overload">OVERLOAD</h1>
            <p>Tableau de bord et gestionejzaejazen du système</p>
        </div>

        {# Statistiques globales #}
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Parties jouées</div>
                <div class="stat-value">{{ globalStats.totalGames }}</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Meilleur score</div>
                <div class="stat-value">{{ globalStats.highestScore }}</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Score moyen</div>
                <div class="stat-value">{{ globalStats.averageScore|number_format(0) }}</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Durée moyenne</div>
                <div class="stat-value">
                    {{ globalStats.averageDuration|number_format(1) }}
                    <span class="stat-unit">sec</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Joueurs uniques</div>
                <div class="stat-value">{{ globalStats.uniquePlayers }}</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Parties aujourd'hui</div>
                <div class="stat-value">{{ todayStats.gamesToday }}</div>
            </div>
        </div>

        {# Contenu principal #}
        <div class="main-grid">
            {# Top 3 Joueurs #}
            <div class="section">
                <h2 class="section-title">Top 3 Joueurs</h2>

                {% if topPlayers|length > 0 %}
                    <div class="podium">
                        {% for player in topPlayers|slice(0, 3) %}
                            <div class="podium-place {{ loop.index == 1 ? 'first' : (loop.index == 2 ? 'second' : 'third') }}">
                                <div class="podium-rank">{{ loop.index }}</div>
                                <div class="podium-bar">
                                    <div class="podium-name">{{ player.playerName }}</div>
                                    <div class="podium-score">{{ player.score }}</div>
                                    <div class="recent-time">{{ player.duration|number_format(1) }}s</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">
                        <p>Aucun score enregistré</p>
                        <p style="font-size: 0.9em; margin-top: 8px;">Jouez une partie pour voir les résultats ici !</p>
                    </div>
                {% endif %}
            </div>

            {# Scores récents #}
            <div class="section">
                <h2 class="section-title">Dernières parties</h2>

                {% if recentScores|length > 0 %}
                    {% for score in recentScores %}
                        <div class="recent-score">
                            <div>
                                <div class="recent-player">{{ score.playerName }}</div>
                                <div class="recent-time">{{ score.playedAt|date('d/m/Y H:i') }}</div>
                            </div>
                            <div style="text-align: right;">
                                <div class="recent-score-value">{{ score.score }} pts</div>
                                <div class="recent-time">{{ score.duration|number_format(1) }}s</div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-state">
                        <p>Aucune partie récente</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Actions rapides #}
        <h2 class="section-title" style="margin-bottom: 20px;">Actions rapides</h2>
        <div class="actions-grid">
            <a href="{{ path('app_scores') }}" class="action-card">
                <div class="action-title">Scores</div>
                <div class="action-desc">Voir le classement complet des meilleurs joueurs</div>
                <div class="action-arrow">→</div>
            </a>

            <a href="{{ path('app_stats') }}" class="action-card">
                <div class="action-title">Statistiques</div>
                <div class="action-desc">Données globales et analytics du système</div>
                <div class="action-arrow">→</div>
            </a>

            <a href="/api" class="action-card">
                <div class="action-title">API</div>
                <div class="action-desc">Documentation technique et endpoints</div>
                <div class="action-arrow">→</div>
            </a>

            <a href="{{ path('app_settings') }}" class="action-card">
                <div class="action-title">Paramètres</div>
                <div class="action-desc">Configuration et réglages du jeu</div>
                <div class="action-arrow">→</div>
            </a>
        </div>

        <footer style="text-align: center; margin-top: 60px; color: var(--text-muted); font-size: 0.85em;">
            © {{ "now"|date("Y") }} OVERLOAD
        </footer>
    </div>
{% endblock %}
