{% extends 'base.html.twig' %}
{% block title %}Dashboard — Claw Machine{% endblock %}

{% block body %}
    <style>
        body {
            font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
            background: #121212;
            color: #e0e0e0;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        h1 {
            font-size: 2.2em;
            font-weight: 600;
            margin-bottom: 40px;
            color: #ffffff;
        }

        .dashboard {
            display: flex;
            flex-wrap: nowrap;
            justify-content: center;
            gap: 25px;
            max-width: 800px;
            width: 90%;
        }

        .card {
            background: #1e1e1e;
            border-radius: 10px;
            width: 240px;
            height: 130px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            text-decoration: none;
            color: #e0e0e0;
            border: 1px solid #2a2a2a;
            transition: 0.2s ease;
        }

        .card:hover {
            background: #2a2a2a;
            transform: translateY(-3px);
        }

        .card h2 {
            font-size: 1.2em;
            margin-bottom: 8px;
            color: #ffffff;
        }

        .card p {
            font-size: 0.9em;
            color: #aaa;
        }

        footer {
            position: absolute;
            bottom: 20px;
            font-size: 0.8em;
            color: #555;
        }
    </style>

    <h1>Claw Machine Dashboard</h1>

    <div class="dashboard">
        <a href="/scores" class="card">
            <h2>Scores</h2>
            <p>Voir le classement des joueurs</p>
        </a>
        <a href="/stats" class="card">
            <h2>Statistiques</h2>
            <p>Consulter les données globales</p>
        </a>
        <a href="/api" class="card">
            <h2>API</h2>
            <p>Interface API Platform</p>
        </a>
        <a href="/settings" class="card">
            <h2>Paramètres</h2>
            <p>Modifier le temps, la difficulté...</p>
        </a>
    </div>


    <footer>© {{ "now"|date("Y") }} Claw Machine</footer>
{% endblock %}
