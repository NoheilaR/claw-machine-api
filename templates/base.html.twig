<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎮</text></svg>">

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

        <!-- Y2K Neon Theme -->
        <link rel="stylesheet" href="{{ asset('css/y2k-neon.css') }}">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        <!-- Grandes lumières violettes en fond -->
        <div class="glow-orb glow-orb-1"></div>
        <div class="glow-orb glow-orb-2"></div>
        <div class="glow-orb glow-orb-3"></div>

        <!-- Conteneur pour les particules -->
        <div id="particles"></div>

        {% block body %}{% endblock %}

        <script>
            // Génération légère de particules
            const particlesContainer = document.getElementById('particles');
            const particleCount = 25; // Nombre réduit pour rester léger

            function createParticle() {
                const particle = document.createElement('div');
                particle.className = 'particle';

                // Position aléatoire
                particle.style.left = Math.random() * 100 + '%';
                particle.style.bottom = '-10px';

                // Durée d'animation aléatoire
                const duration = 15 + Math.random() * 15; // Entre 15 et 30 secondes
                particle.style.animationDuration = duration + 's';

                // Dérive horizontale aléatoire
                const drift = (Math.random() - 0.5) * 100;
                particle.style.setProperty('--drift', drift + 'px');

                // Délai aléatoire pour un effet naturel
                particle.style.animationDelay = Math.random() * 10 + 's';

                // Variation d'opacité
                particle.style.opacity = 0.3 + Math.random() * 0.5;

                particlesContainer.appendChild(particle);
            }

            // Créer les particules
            for (let i = 0; i < particleCount; i++) {
                createParticle();
            }
        </script>
    </body>
</html>
