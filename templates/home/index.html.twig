{% extends 'base.html.twig' %}
{% block title %}OVERLOAD - Arcade Game{% endblock %}

{% block body %}
    <style>
        @font-face {
            font-family: 'Excelorate';
            src: url('{{ asset('fonts/Excelorate.ttf') }}') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Animations au scroll */
        .fade-in {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .slide-left {
            opacity: 0;
            transform: translateX(-60px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .slide-left.visible {
            opacity: 1;
            transform: translateX(0);
        }

        .slide-right {
            opacity: 0;
            transform: translateX(60px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .slide-right.visible {
            opacity: 1;
            transform: translateX(0);
        }

        /* Floating plushies background */
        .floating-plushies {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 1;
            overflow: hidden;
        }

        .floating-plush {
            position: absolute;
            opacity: 0.15;
            animation: float-random 20s infinite ease-in-out;
        }

        .floating-plush:nth-child(1) { left: 5%; top: 20%; animation-delay: 0s; width: 80px; }
        .floating-plush:nth-child(2) { right: 8%; top: 35%; animation-delay: -5s; width: 60px; }
        .floating-plush:nth-child(3) { left: 12%; bottom: 25%; animation-delay: -10s; width: 70px; }
        .floating-plush:nth-child(4) { right: 15%; bottom: 15%; animation-delay: -15s; width: 50px; }
        .floating-plush:nth-child(5) { left: 50%; top: 10%; animation-delay: -8s; width: 40px; }
        .floating-plush:nth-child(6) { right: 25%; top: 60%; animation-delay: -12s; width: 55px; }

        @keyframes float-random {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            25% { transform: translateY(-20px) rotate(5deg); }
            50% { transform: translateY(10px) rotate(-3deg); }
            75% { transform: translateY(-15px) rotate(3deg); }
        }

        /* Navigation */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(10, 10, 15, 0.95);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        }

        .nav-logo {
            font-family: 'Excelorate', sans-serif;
            font-size: 1.8em;
            color: var(--purple);
            letter-spacing: 3px;
        }

        .nav-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.75em;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: #22c55e;
            border-radius: 50%;
            animation: pulse-dot 2s infinite;
        }

        @keyframes pulse-dot {
            0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4); }
            50% { opacity: 0.8; box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); }
        }

        .nav-links {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.8em;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            padding: 10px 14px;
            border-radius: 6px;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 38px;
            line-height: 1;
        }

        .nav-links a:hover {
            color: var(--text-primary);
            background: rgba(139, 92, 246, 0.1);
            border-color: rgba(139, 92, 246, 0.2);
        }

        .nav-links a.admin-link {
            color: var(--purple);
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.05);
        }

        .nav-links a.admin-link:hover {
            background: rgba(139, 92, 246, 0.15);
            border-color: var(--purple);
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 140px 40px 100px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(ellipse at 30% 20%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
                        radial-gradient(ellipse at 70% 80%, rgba(236, 72, 153, 0.1) 0%, transparent 50%);
            pointer-events: none;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            align-items: center;
            position: relative;
            z-index: 10;
        }

        .hero-content {
            z-index: 10;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(139, 92, 246, 0.15);
            border: 1px solid rgba(139, 92, 246, 0.4);
            padding: 10px 18px;
            border-radius: 50px;
            font-size: 0.8em;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--purple);
            margin-bottom: 28px;
        }


        .hero-title {
            font-family: 'Excelorate', sans-serif;
            font-size: 6em;
            font-weight: 400;
            line-height: 1;
            margin-bottom: 28px;
            color: #ffffff;
            letter-spacing: 4px;
            text-shadow: 0 0 40px rgba(255, 255, 255, 0.3);
        }

        .hero-subtitle {
            font-size: 1.5em;
            color: var(--text-primary);
            margin-bottom: 20px;
            font-weight: 600;
        }

        .hero-desc {
            font-size: 1.1em;
            color: var(--text-secondary);
            line-height: 1.9;
            margin-bottom: 40px;
            max-width: 520px;
        }

        .hero-cta {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            border: none;
            padding: 18px 36px;
            border-radius: 12px;
            color: #fff;
            font-weight: 600;
            font-size: 1em;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(139, 92, 246, 0.5);
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.2);
            padding: 18px 36px;
            border-radius: 12px;
            color: var(--text-primary);
            font-weight: 600;
            font-size: 1em;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .btn-secondary:hover {
            border-color: var(--purple);
            background: rgba(139, 92, 246, 0.1);
        }

        .hero-image {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .machine-img {
            max-width: 100%;
            height: auto;
            max-height: 650px;
            filter: drop-shadow(0 0 80px rgba(139, 92, 246, 0.4));
            animation: machine-float 5s ease-in-out infinite;
        }

        @keyframes machine-float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(1deg); }
        }

        .hero-stats {
            display: flex;
            gap: 40px;
            margin-top: 50px;
            padding-top: 30px;
            border-top: 1px solid rgba(139, 92, 246, 0.2);
        }

        .hero-stat {
            text-align: left;
        }

        .hero-stat-value {
            font-size: 2em;
            font-weight: 700;
            color: var(--purple);
        }

        .hero-stat-label {
            font-size: 0.85em;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Section commune */
        section {
            padding: 120px 40px;
            max-width: 1400px;
            margin: 0 auto;
            position: relative;
            z-index: 10;
        }

        .section-header {
            text-align: center;
            margin-bottom: 70px;
        }

        .section-tag {
            display: inline-block;
            color: var(--purple);
            font-size: 0.85em;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .section-title {
            font-size: 3.5em;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .section-desc {
            color: var(--text-secondary);
            font-size: 1.1em;
            max-width: 600px;
            margin: 20px auto 0;
            line-height: 1.8;
        }

        /* Features - Bento Grid */
        .features {
            background: linear-gradient(180deg, transparent 0%, rgba(139, 92, 246, 0.05) 50%, transparent 100%);
            padding: 120px 40px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            grid-template-rows: auto auto;
            gap: 24px;
        }

        .feature-card {
            background: rgba(15, 15, 25, 0.8);
            border-radius: 24px;
            padding: 45px 35px;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .feature-card:first-child {
            grid-row: span 2;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .feature-card:first-child .feature-icon {
            width: 100px;
            height: 100px;
        }

        .feature-card:first-child .feature-title {
            font-size: 1.8em;
        }

        .feature-card:first-child .feature-desc {
            font-size: 1.1em;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(139, 92, 246, 0.15);
        }

        .feature-icon {
            width: 60px;
            height: 60px;
            margin-bottom: 25px;
            filter: drop-shadow(0 0 20px rgba(139, 92, 246, 0.5));
        }

        .feature-title {
            font-size: 1.3em;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .feature-desc {
            color: var(--text-muted);
            line-height: 1.8;
            font-size: 0.95em;
        }

        /* Tokens section */
        .tokens-section {
            background: rgba(139, 92, 246, 0.03);
        }

        .tokens-grid {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 60px;
            flex-wrap: wrap;
        }

        .token-item {
            text-align: center;
            padding: 35px 40px;
            background: rgba(15, 15, 25, 0.6);
            border-radius: 24px;
            transition: all 0.3s ease;
            flex: 0 1 280px;
        }

        .token-item:nth-child(1) {
            transform: translateY(0);
        }

        .token-item:nth-child(2) {
            transform: translateY(30px);
        }

        .token-item:nth-child(3) {
            transform: translateY(-15px);
        }

        .token-item:nth-child(4) {
            transform: translateY(20px);
        }

        .token-item:hover {
            transform: scale(1.05) translateY(var(--hover-offset, 0));
        }

        .token-item:nth-child(1):hover { --hover-offset: -10px; transform: scale(1.05) translateY(-10px); }
        .token-item:nth-child(2):hover { --hover-offset: 20px; transform: scale(1.05) translateY(20px); }
        .token-item:nth-child(3):hover { --hover-offset: -25px; transform: scale(1.05) translateY(-25px); }
        .token-item:nth-child(4):hover { --hover-offset: 10px; transform: scale(1.05) translateY(10px); }

        .token-img {
            width: 90px;
            height: 90px;
            margin-bottom: 20px;
            filter: drop-shadow(0 0 25px rgba(139, 92, 246, 0.6));
            animation: token-pulse 3s ease-in-out infinite;
        }

        .token-item:nth-child(2) .token-img {
            animation-delay: -1s;
            filter: drop-shadow(0 0 25px rgba(239, 68, 68, 0.6));
        }

        .token-item:nth-child(3) .token-img {
            animation-delay: -2s;
            filter: drop-shadow(0 0 25px rgba(245, 158, 11, 0.6));
        }

        .token-item:nth-child(4) .token-img {
            animation-delay: -3s;
            filter: drop-shadow(0 0 25px rgba(6, 182, 212, 0.6));
        }

        @keyframes token-pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .token-name {
            font-size: 1.2em;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .token-effect {
            color: var(--text-muted);
            font-size: 0.9em;
        }

        .token-effect.good { color: #22c55e; }
        .token-effect.bad { color: #ef4444; }
        .token-effect.neutral { color: #f59e0b; }

        /* How to play */
        .howto {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .howto-content {
            order: 1;
        }

        .howto-image {
            order: 2;
            position: relative;
        }

        .howto-image img {
            width: 100%;
            border-radius: 20px;
            border: 1px solid rgba(139, 92, 246, 0.2);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .howto-list {
            list-style: none;
            margin-top: 40px;
        }

        .howto-list li {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 28px;
            color: var(--text-secondary);
            line-height: 1.7;
            font-size: 1.05em;
        }

        .howto-list .num {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 44px;
            height: 44px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), rgba(236, 72, 153, 0.2));
            border: 1px solid rgba(139, 92, 246, 0.5);
            border-radius: 12px;
            color: #fff;
            font-weight: 700;
            font-size: 1em;
        }

        /* Plushies showcase */
        .plushies-section {
            text-align: center;
        }

        .plushies-categories {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-top: 60px;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }

        .plush-category {
            background: rgba(15, 15, 25, 0.6);
            border-radius: 24px;
            padding: 40px 30px;
            position: relative;
            overflow: hidden;
        }

        .plush-category::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--purple), #a78bfa);
        }

        .plush-category.rare::before {
            background: linear-gradient(90deg, #fbbf24, #f59e0b);
        }

        .category-title {
            font-size: 1.3em;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 25px;
        }

        .plush-variants {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 20px;
        }

        .plush-item {
            text-align: center;
            transition: transform 0.3s ease;
        }

        .plush-item:hover {
            transform: translateY(-10px);
        }

        .plush-item.glowy .plush-img {
            filter: drop-shadow(0 0 40px rgba(139, 92, 246, 0.8)) brightness(1.3);
        }

        .plush-category.rare .plush-item.glowy .plush-img {
            filter: drop-shadow(0 0 40px rgba(251, 191, 36, 0.8)) brightness(1.3);
        }

        .plush-img {
            width: 90px;
            height: 90px;
            filter: drop-shadow(0 0 20px rgba(139, 92, 246, 0.4));
            animation: plush-bounce 4s ease-in-out infinite;
        }

        .plush-item:nth-child(2) .plush-img { animation-delay: -2s; }

        @keyframes plush-bounce {
            0%, 100% { transform: translateY(0) rotate(-3deg); }
            50% { transform: translateY(-10px) rotate(3deg); }
        }

        .plush-label {
            margin-top: 10px;
            font-size: 0.85em;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .plush-points {
            font-weight: 700;
            color: var(--purple);
            font-size: 1.4em;
        }

        .plush-category.rare .plush-points {
            color: #fbbf24;
        }

        /* Leaderboard preview */
        .leaderboard-section {
            padding: 120px 40px;
        }

        .leaderboard-preview {
            background: rgba(15, 15, 25, 0.8);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 20px;
            overflow: hidden;
            max-width: 750px;
            margin: 0 auto;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .lb-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 30px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(236, 72, 153, 0.1));
            border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        }

        .lb-header h3 {
            font-size: 1.1em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .lb-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.8em;
            color: #22c55e;
            font-weight: 600;
        }

        .lb-row {
            display: grid;
            grid-template-columns: 60px 1fr 120px;
            padding: 20px 30px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.1);
            align-items: center;
            transition: background 0.3s ease;
        }

        .lb-row:hover {
            background: rgba(139, 92, 246, 0.05);
        }

        .lb-row:last-of-type {
            border-bottom: none;
        }

        .lb-rank {
            font-weight: 700;
            font-size: 1.2em;
        }

        .lb-rank.gold { color: #ffd700; text-shadow: 0 0 20px rgba(255, 215, 0, 0.5); }
        .lb-rank.silver { color: #c0c0c0; }
        .lb-rank.bronze { color: #cd7f32; }

        .lb-name {
            font-weight: 600;
            font-size: 1.05em;
        }

        .lb-score {
            text-align: right;
            font-weight: 700;
            color: var(--purple);
            font-size: 1.1em;
        }

        .lb-cta {
            text-align: center;
            padding: 28px;
            background: rgba(139, 92, 246, 0.05);
        }

        .lb-cta a {
            color: var(--purple);
            text-decoration: none;
            font-weight: 600;
            font-size: 1em;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .lb-cta a:hover {
            gap: 12px;
        }

        /* Footer */
        .footer {
            padding: 50px 40px;
            text-align: center;
            border-top: 1px solid rgba(139, 92, 246, 0.1);
            background: rgba(10, 10, 15, 0.5);
        }

        .footer-logo {
            font-family: 'Excelorate', sans-serif;
            font-size: 2em;
            color: var(--purple);
            letter-spacing: 3px;
            margin-bottom: 20px;
        }

        .footer p {
            color: var(--text-muted);
            font-size: 0.9em;
        }

        .footer-links {
            margin-top: 20px;
            display: flex;
            justify-content: center;
            gap: 30px;
        }

        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.9em;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: var(--purple);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .hero-grid {
                grid-template-columns: 1fr;
                text-align: center;
                gap: 50px;
            }

            .hero-content { order: 2; }
            .hero-image { order: 1; }
            .hero-desc { margin: 0 auto 40px; }
            .hero-cta { justify-content: center; }
            .hero-title { font-size: 4em; }
            .hero-stats { justify-content: center; }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .feature-card:first-child {
                grid-row: auto;
            }

            .tokens-grid .token-item {
                transform: translateY(0) !important;
            }

            .tokens-grid .token-item:hover {
                transform: scale(1.05) translateY(-10px) !important;
            }

            .plushies-categories {
                grid-template-columns: 1fr;
            }

            .howto {
                grid-template-columns: 1fr;
            }

            .howto-content, .howto-image { order: initial; }
        }

        @media (max-width: 768px) {
            .navbar { padding: 16px 20px; }
            .nav-links { display: none; }
            .hero { padding: 100px 20px 60px; }
            .hero-title { font-size: 3em; }
            section { padding: 80px 20px; }
            .section-title { font-size: 2.2em; }
            .hero-cta { flex-direction: column; }
            .btn-primary, .btn-secondary { width: 100%; justify-content: center; }
            .floating-plushies { display: none; }
            .plush-variants { gap: 20px; }
            .plush-img { width: 70px; height: 70px; }
            .plush-category { padding: 30px 20px; }
        }
    </style>

    <!-- Floating plushies background -->
    <div class="floating-plushies">
        <img src="{{ asset('images/plush_bunny.png') }}" class="floating-plush" alt="">
        <img src="{{ asset('images/plush_ghost.png') }}" class="floating-plush" alt="">
