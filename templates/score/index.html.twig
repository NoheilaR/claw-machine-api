{% extends 'base.html.twig' %}
{% block title %}Scores — Claw Machine{% endblock %}

{% block body %}
    <style>
        .scores-page {
            min-height: 100vh;
            padding: 60px 20px;
            position: relative;
            z-index: 1;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 40px 0;
            padding: 10px 20px;
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            border-radius: 8px;
            border: 1px solid transparent;
        }

        .back-button:hover {
            color: var(--text-primary);
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.05);
        }

        .page-header {
            max-width: 1100px;
            margin: 0 auto 40px;
        }

        .page-header h1 {
            font-size: 2.5em;
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .page-header p {
            color: var(--text-secondary);
            font-size: 1em;
        }

        .scores-container {
            max-width: 1100px;
            margin: 0 auto;
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.15);
            border-radius: 12px;
            padding: 0;
            overflow: hidden;
        }

        .scores-table {
            width: 100%;
            border-collapse: collapse;
        }

        .scores-table thead tr {
            border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        }

        .scores-table thead th {
            padding: 20px 24px;
            text-align: left;
            font-weight: 600;
            color: var(--text-secondary);
            font-size: 0.85em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .scores-table thead th:nth-child(2),
        .scores-table thead th:nth-child(3),
        .scores-table thead th:nth-child(4) {
            text-align: center;
        }

        .scores-table tbody tr {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.2s ease;
        }

        .scores-table tbody tr:last-child {
            border-bottom: none;
        }

        .scores-table tbody tr:hover {
            background: rgba(139, 92, 246, 0.05);
        }

        .scores-table tbody td {
            padding: 18px 24px;
            color: var(--text-secondary);
        }

        .scores-table tbody td:nth-child(2),
        .scores-table tbody td:nth-child(3),
        .scores-table tbody td:nth-child(4) {
            text-align: center;
        }

        .player-name {
            color: var(--text-primary);
            font-weight: 500;
        }

        .score-value {
            color: var(--purple);
            font-weight: 600;
            font-size: 1.1em;
        }

        .rank {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85em;
            margin-right: 12px;
        }

        .rank-1 {
            background: rgba(139, 92, 246, 0.2);
            color: var(--purple);
        }

        .rank-2 {
            background: rgba(236, 72, 153, 0.2);
            color: var(--pink);
        }

        .rank-3 {
            background: rgba(59, 130, 246, 0.2);
            color: var(--blue);
        }

        .no-scores {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
        }

        @media (max-width: 768px) {
            .page-header h1 {
                font-size: 2em;
            }

            .scores-table thead th,
            .scores-table tbody td {
                padding: 14px 12px;
                font-size: 0.9em;
            }

            .rank {
                margin-right: 8px;
            }
        }
    </style>

    <div class="scores-page">
        <div class="page-header">
            <a href="{{ path('dashboard') }}" class="back-button">← Retour</a>
            <h1>Classement</h1>
            <p>Meilleurs scores enregistrés</p>
        </div>

        <div class="scores-container">
            <table class="scores-table">
                <thead>
                <tr>
                    <th>Joueur</th>
                    <th>Score</th>
                    <th>Durée</th>
                    <th>Date</th>
                </tr>
                </thead>
                <tbody>
                {% for score in scores %}
                    <tr>
                        <td>
                            {% if loop.index <= 3 %}
                                <span class="rank rank-{{ loop.index }}">{{ loop.index }}</span>
                            {% endif %}
                            <span class="player-name">{{ score.playerName }}</span>
                        </td>
                        <td><span class="score-value">{{ score.score }}</span></td>
                        <td>{{ score.duration }}s</td>
                        <td>{{ score.playedAt ? score.playedAt|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="no-scores">Aucun score enregistré</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
