{% extends 'base.html.twig' %}
{% block title %}Admin - OVERLOAD{% endblock %}

{% block body %}
    <style>
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
        }

        .admin-header h1 {
            font-size: 2.5em;
            font-weight: 700;
            background: linear-gradient(135deg, #ffffff 0%, #a1a1aa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .admin-nav {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .nav-link {
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            color: var(--text-secondary);
            font-weight: 500;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .nav-link:hover {
            color: var(--text-primary);
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.05);
        }

        .nav-link.active {
            background: rgba(139, 92, 246, 0.2);
            border-color: rgba(139, 92, 246, 0.4);
            color: var(--text-primary);
        }

        .logout-btn {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
        }

        .logout-btn:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(239, 68, 68, 0.5);
            color: #ef4444;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 24px;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: rgba(139, 92, 246, 0.4);
            box-shadow: var(--glow-purple);
        }

        .stat-label {
            font-size: 0.85em;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 2em;
            font-weight: 700;
            color: var(--purple);
        }

        /* Main Grid */
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 40px;
        }

        .section {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 28px;
        }

        .section-title {
            font-size: 1.3em;
            font-weight: 600;
            margin-bottom: 20px;
            color: var(--text-primary);
        }

        /* Podium */
        .podium {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 16px;
            margin-top: 20px;
        }

        .podium-place {
            flex: 1;
            max-width: 150px;
            text-align: center;
        }

        .podium-place.first { order: 2; }
        .podium-place.second { order: 1; }
        .podium-place.third { order: 3; }

        .podium-rank {
            width: 50px;
            height: 50px;
            margin: 0 auto 12px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5em;
            font-weight: 700;
        }

        .podium-place.first .podium-rank {
            background: linear-gradient(135deg, #ffd700, #ffa500);
            color: #000;
            width: 60px;
            height: 60px;
            font-size: 1.8em;
        }

        .podium-place.second .podium-rank {
            background: linear-gradient(135deg, #c0c0c0, #808080);
            color: #000;
        }

        .podium-place.third .podium-rank {
            background: linear-gradient(135deg, #cd7f32, #8b4513);
            color: #fff;
        }

        .podium-bar {
            background: linear-gradient(180deg, rgba(139, 92, 246, 0.3), rgba(139, 92, 246, 0.1));
            border: 1px solid rgba(139, 92, 246, 0.4);
            border-radius: 8px 8px 0 0;
            padding: 20px 12px;
            margin-top: 12px;
        }

        .podium-place.first .podium-bar { height: 160px; }
        .podium-place.second .podium-bar { height: 120px; }
        .podium-place.third .podium-bar { height: 90px; }

        .podium-name {
            font-size: 0.9em;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .podium-score {
            font-size: 1.3em;
            font-weight: 700;
            color: var(--purple);
        }

        /* Recent Scores */
        .recent-score {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.1);
        }

        .recent-score:last-child { border-bottom: none; }

        .recent-player {
            font-weight: 600;
            color: var(--text-primary);
        }

        .recent-score-value {
            font-weight: 700;
            color: var(--purple);
        }

        .recent-time {
            font-size: 0.85em;
            color: var(--text-muted);
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }

        @media (max-width: 968px) {
            .main-grid { grid-template-columns: 1fr; }
            .admin-header { flex-direction: column; gap: 20px; }
        }
    </style>

    <div class="container">
        <div class="admin-header">
            <h1>Administration</h1>
            <nav class="admin-nav">
                <a href="{{ path('leaderboard') }}" class="nav-link">Classement public</a>
                <a href="{{ path('admin_dashboard') }}" class="nav-link active">Dashboard</a>
                <a href="{{ path('admin_settings') }}" class="nav-link">Parametres</a>
                <a href="{{ path('app_logout') }}" class="nav-link logout-btn">Deconnexion</a>
            </nav>
        </div>

        <!-- Statistiques globales -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Parties jouees</div>
                <div class="stat-value">{{ globalStats.totalGames }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Meilleur score</div>
                <div class="stat-value">{{ globalStats.highestScore }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Score moyen</div>
                <div class="stat-value">{{ globalStats.averageScore|number_format(0) }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Duree moyenne</div>
                <div class="stat-value">{{ globalStats.averageDuration|number_format(1) }}s</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Joueurs uniques</div>
                <div class="stat-value">{{ globalStats.uniquePlayers }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Parties aujourd'hui</div>
                <div class="stat-value">{{ todayStats.gamesToday }}</div>
            </div>
        </div>

        <!-- Contenu principal -->
        <div class="main-grid">
            <!-- Top 3 -->
            <div class="section">
                <h2 class="section-title">Top 3 Joueurs</h2>
                {% if topPlayers|length > 0 %}
                    <div class="podium">
                        {% for player in topPlayers|slice(0, 3) %}
                            <div class="podium-place {{ loop.index == 1 ? 'first' : (loop.index == 2 ? 'second' : 'third') }}">
                                <div class="podium-rank">{{ loop.index }}</div>
                                <div class="podium-bar">
                                    <div class="podium-name">{{ player.playerName }}</div>
                                    <div class="podium-score">{{ player.score }}</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">Aucun score enregistre</div>
                {% endif %}
            </div>

            <!-- Scores récents -->
            <div class="section">
                <h2 class="section-title">Dernieres parties</h2>
                {% if recentScores|length > 0 %}
                    {% for score in recentScores %}
                        <div class="recent-score">
                            <div>
                                <div class="recent-player">{{ score.playerName }}</div>
                                <div class="recent-time">{{ score.playedAt|date('d/m/Y H:i') }}</div>
                            </div>
                            <div style="text-align: right;">
                                <div class="recent-score-value">{{ score.score }} pts</div>
                                <div class="recent-time">{{ score.duration|number_format(1) }}s</div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-state">Aucune partie recente</div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
