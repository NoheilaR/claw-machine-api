{% extends 'base.html.twig' %}
{% block title %}Parametres - Admin{% endblock %}

{% block body %}
    <style>
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
        }

        .admin-header h1 {
            font-size: 2em;
            font-weight: 700;
        }

        .admin-nav {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .nav-link {
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            color: var(--text-secondary);
            font-weight: 500;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .nav-link:hover {
            color: var(--text-primary);
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.05);
        }

        .nav-link.active {
            background: rgba(139, 92, 246, 0.2);
            border-color: rgba(139, 92, 246, 0.4);
            color: var(--text-primary);
        }

        .logout-btn {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
        }

        .settings-container {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 32px;
        }

        .flash-message {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 24px;
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid var(--cyan);
            color: var(--cyan);
        }

        .section-header {
            margin: 32px 0 20px 0;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.3);
        }

        .section-header:first-of-type { margin-top: 0; }

        .section-header h3 {
            font-size: 1.2em;
            font-weight: 600;
            color: var(--purple);
            margin: 0 0 4px 0;
        }

        .section-desc {
            font-size: 0.85em;
            color: var(--text-muted);
            margin: 0;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .form-row label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-primary);
            font-size: 0.85em;
            font-weight: 600;
        }

        .form-row input[type="number"] {
            width: 100%;
            background: rgba(15, 15, 25, 0.4);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 10px 14px;
            font-size: 0.95em;
            transition: all 0.3s ease;
        }

        .form-row input:focus {
            outline: none;
            border-color: var(--purple);
            box-shadow: var(--glow-purple);
        }

        .help-text {
            margin-top: 4px;
            font-size: 0.75em;
            color: var(--text-muted);
        }

        .current-value {
            display: inline-block;
            margin-left: 8px;
            padding: 2px 6px;
            background: rgba(139, 92, 246, 0.2);
            border-radius: 4px;
            font-size: 0.75em;
            color: var(--purple);
            font-weight: 600;
        }

        .submit-btn {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.1));
            border: 1px solid rgba(139, 92, 246, 0.5);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 14px 32px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 32px;
        }

        .submit-btn:hover {
            border-color: var(--purple);
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), rgba(236, 72, 153, 0.2));
            box-shadow: var(--glow-purple);
        }

        @media (max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
            .admin-header { flex-direction: column; gap: 20px; text-align: center; }
        }
    </style>

    <div class="container">
        <div class="admin-header">
            <h1>Parametres du jeu</h1>
            <nav class="admin-nav">
                <a href="{{ path('home') }}" class="nav-link">Site public</a>
                <a href="{{ path('admin_dashboard') }}" class="nav-link">Dashboard</a>
                <a href="{{ path('admin_settings') }}" class="nav-link active">Parametres</a>
                <a href="{{ path('app_logout') }}" class="nav-link logout-btn">Deconnexion</a>
            </nav>
        </div>

        <div class="settings-container">
            {% for message in app.flashes('success') %}
                <div class="flash-message">{{ message }}</div>
            {% endfor %}

            {{ form_start(form) }}

            {# GENERAL #}
            <div class="section-header">
                <h3>General</h3>
                <p class="section-desc">Parametres globaux de la partie</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.timeLimit) }}
                    <span class="current-value">{{ settings.timeLimit }}s</span>
                    {{ form_widget(form.timeLimit) }}
                    {{ form_help(form.timeLimit) }}
                </div>
            </div>

            {# ENERGY TOKENS #}
            <div class="section-header">
                <h3>Energy Tokens</h3>
                <p class="section-desc">Jetons qui rechargent l'energie</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.energyTokenProbability) }}
                    <span class="current-value">{{ settings.energyTokenProbability }}%</span>
                    {{ form_widget(form.energyTokenProbability) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.minEnergyTokens) }}
                    <span class="current-value">{{ settings.minEnergyTokens }}</span>
                    {{ form_widget(form.minEnergyTokens) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.maxEnergyTokens) }}
                    <span class="current-value">{{ settings.maxEnergyTokens }}</span>
                    {{ form_widget(form.maxEnergyTokens) }}
                </div>
            </div>

            {# BOMB TOKENS #}
            <div class="section-header">
                <h3>Bomb Tokens</h3>
                <p class="section-desc">Jetons explosifs</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.bombTokenProbability) }}
                    <span class="current-value">{{ settings.bombTokenProbability }}%</span>
                    {{ form_widget(form.bombTokenProbability) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.minBombTokens) }}
                    <span class="current-value">{{ settings.minBombTokens }}</span>
                    {{ form_widget(form.minBombTokens) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.maxBombTokens) }}
                    <span class="current-value">{{ settings.maxBombTokens }}</span>
                    {{ form_widget(form.maxBombTokens) }}
                </div>
            </div>

            {# BLACKOUT TOKENS #}
            <div class="section-header">
                <h3>Blackout Tokens</h3>
                <p class="section-desc">Mode blackout (x2 points)</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.blackoutTokenProbability) }}
                    <span class="current-value">{{ settings.blackoutTokenProbability }}%</span>
                    {{ form_widget(form.blackoutTokenProbability) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.minBlackoutTokens) }}
                    <span class="current-value">{{ settings.minBlackoutTokens }}</span>
                    {{ form_widget(form.minBlackoutTokens) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.maxBlackoutTokens) }}
                    <span class="current-value">{{ settings.maxBlackoutTokens }}</span>
                    {{ form_widget(form.maxBlackoutTokens) }}
                </div>
            </div>

            {# PELUCHES QUANTITES #}
            <div class="section-header">
                <h3>Peluches - Quantites</h3>
                <p class="section-desc">Nombre de peluches et respawn</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.initialPlushieCount) }}
                    <span class="current-value">{{ settings.initialPlushieCount }}</span>
                    {{ form_widget(form.initialPlushieCount) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.minPlushiesBeforeRespawn) }}
                    <span class="current-value">{{ settings.minPlushiesBeforeRespawn }}</span>
                    {{ form_widget(form.minPlushiesBeforeRespawn) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.maxPlushiesInBin) }}
                    <span class="current-value">{{ settings.maxPlushiesInBin }}</span>
                    {{ form_widget(form.maxPlushiesInBin) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.plushiesPerSpawn) }}
                    <span class="current-value">{{ settings.plushiesPerSpawn }}</span>
                    {{ form_widget(form.plushiesPerSpawn) }}
                </div>
            </div>

            {# PELUCHES RARETES #}
            <div class="section-header">
                <h3>Peluches - Raretes</h3>
                <p class="section-desc">Probabilites par rarete</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.commonProbability) }}
                    <span class="current-value">{{ settings.commonProbability }}%</span>
                    {{ form_widget(form.commonProbability) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.rareProbability) }}
                    <span class="current-value">{{ settings.rareProbability }}%</span>
                    {{ form_widget(form.rareProbability) }}
                </div>
            </div>

            {# GLITCH #}
            <div class="section-header">
                <h3>Perturbation (Glitch)</h3>
                <p class="section-desc">Inversion des commandes</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.glitchProbability) }}
                    <span class="current-value">{{ settings.glitchProbability }}%</span>
                    {{ form_widget(form.glitchProbability) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.glitchEnergyThreshold) }}
                    <span class="current-value">{{ settings.glitchEnergyThreshold }}%</span>
                    {{ form_widget(form.glitchEnergyThreshold) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.glitchChangeInterval) }}
                    <span class="current-value">{{ settings.glitchChangeInterval }}s</span>
                    {{ form_widget(form.glitchChangeInterval) }}
                </div>
            </div>

            {{ form_widget(form.save, {'attr': {'class': 'submit-btn'}}) }}

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
