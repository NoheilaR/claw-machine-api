{% extends 'base.html.twig' %}
{% block title %}OVERLOAD - Classement{% endblock %}

{% block body %}
    <style>
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .page-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .page-header h1 {
            font-size: 3em;
            font-weight: 700;
            margin-bottom: 12px;
            background: linear-gradient(135deg, #8b5cf6, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 1.1em;
        }

        /* Stats rapides */
        .quick-stats {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .quick-stat {
            text-align: center;
        }

        .quick-stat-value {
            font-size: 2em;
            font-weight: 700;
            color: var(--purple);
        }

        .quick-stat-label {
            font-size: 0.85em;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Filtres */
        .filters {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: rgba(139, 92, 246, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.3);
            border-radius: 20px;
            color: var(--text-secondary);
            padding: 10px 24px;
            font-size: 0.9em;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .filter-btn:hover {
            border-color: var(--purple);
            color: var(--text-primary);
            background: rgba(139, 92, 246, 0.2);
        }

        .filter-btn.active {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.4), rgba(236, 72, 153, 0.2));
            border-color: var(--purple);
            color: var(--text-primary);
            box-shadow: var(--glow-purple);
        }

        /* Tableau */
        .leaderboard-table {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 16px;
            overflow: hidden;
        }

        .leaderboard-row {
            display: grid;
            grid-template-columns: 60px 1fr 120px 100px;
            align-items: center;
            padding: 16px 24px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.1);
            transition: background 0.2s ease;
        }

        .leaderboard-row:last-child {
            border-bottom: none;
        }

        .leaderboard-row:hover {
            background: rgba(139, 92, 246, 0.05);
        }

        .leaderboard-row.header {
            background: rgba(139, 92, 246, 0.1);
            font-weight: 600;
            font-size: 0.85em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
        }

        .leaderboard-row.header:hover {
            background: rgba(139, 92, 246, 0.1);
        }

        .rank {
            font-weight: 700;
            font-size: 1.1em;
        }

        .rank-1 { color: #ffd700; }
        .rank-2 { color: #c0c0c0; }
        .rank-3 { color: #cd7f32; }

        .player-name {
            font-weight: 600;
            color: var(--text-primary);
        }

        .score {
            font-weight: 700;
            color: var(--purple);
            font-size: 1.1em;
        }

        .duration {
            color: var(--text-muted);
            font-size: 0.9em;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
        }

        .empty-state p {
            margin-bottom: 8px;
        }

        /* Top navbar */
        .top-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            position: absolute;
            top: 0;
            right: 0;
            left: 0;
        }

        .nav-link {
            background: rgba(15, 15, 25, 0.8);
            border: 1px solid rgba(139, 92, 246, 0.3);
            border-radius: 10px;
            padding: 10px 18px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.9em;
            font-weight: 500;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-link:hover {
            border-color: var(--purple);
            color: var(--text-primary);
            background: rgba(139, 92, 246, 0.15);
        }

        @media (max-width: 640px) {
            .leaderboard-row {
                grid-template-columns: 50px 1fr 80px;
                padding: 14px 16px;
            }

            .duration {
                display: none;
            }

            .quick-stats {
                gap: 20px;
            }
        }
    </style>

    <div class="container">
        <div class="page-header">
            <h1 class="title-overload">OVERLOAD</h1>
            <p>Classement des meilleurs joueurs</p>
        </div>

        <!-- Stats rapides -->
        <div class="quick-stats">
            <div class="quick-stat">
                <div class="quick-stat-value">{{ stats.totalGames }}</div>
                <div class="quick-stat-label">Parties</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-value">{{ stats.highestScore }}</div>
                <div class="quick-stat-label">Record</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-value">{{ stats.averageScore }}</div>
                <div class="quick-stat-label">Moyenne</div>
            </div>
        </div>

        <!-- Filtres par période -->
        <div class="filters">
            <a href="{{ path('leaderboard', {period: 'today'}) }}" class="filter-btn {{ period == 'today' ? 'active' : '' }}">
                Aujourd'hui
            </a>
            <a href="{{ path('leaderboard', {period: 'week'}) }}" class="filter-btn {{ period == 'week' ? 'active' : '' }}">
                Cette semaine
            </a>
            <a href="{{ path('leaderboard', {period: 'month'}) }}" class="filter-btn {{ period == 'month' ? 'active' : '' }}">
                Ce mois
            </a>
            <a href="{{ path('leaderboard', {period: 'all'}) }}" class="filter-btn {{ period == 'all' ? 'active' : '' }}">
                Tout temps
            </a>
        </div>

        <!-- Tableau des scores -->
        <div class="leaderboard-table">
            <div class="leaderboard-row header">
                <div>#</div>
                <div>Joueur</div>
                <div>Score</div>
                <div>Duree</div>
            </div>

            {% if scores|length > 0 %}
                {% for score in scores %}
                    <div class="leaderboard-row">
                        <div class="rank rank-{{ loop.index <= 3 ? loop.index : '' }}">
                            {% if loop.index == 1 %}
                                <span style="font-size: 1.3em;">1</span>
                            {% elseif loop.index == 2 %}
                                <span style="font-size: 1.2em;">2</span>
                            {% elseif loop.index == 3 %}
                                <span style="font-size: 1.1em;">3</span>
                            {% else %}
                                {{ loop.index }}
                            {% endif %}
                        </div>
                        <div class="player-name">{{ score.playerName }}</div>
                        <div class="score">{{ score.score }} pts</div>
                        <div class="duration">{{ score.duration|number_format(1) }}s</div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <p>Aucun score pour cette periode</p>
                    <p style="font-size: 0.9em;">Jouez une partie pour apparaitre ici !</p>
                </div>
            {% endif %}
        </div>

        <footer style="text-align: center; margin-top: 40px; color: var(--text-muted); font-size: 0.85em;">
            © {{ "now"|date("Y") }} OVERLOAD
        </footer>
    </div>

    <!-- Navigation en haut -->
    <nav class="top-nav">
        <a href="{{ path('home') }}" class="nav-link">
            ← Retour
        </a>
        <a href="{{ path('app_login') }}" class="nav-link">
            Admin
        </a>
    </nav>
{% endblock %}
