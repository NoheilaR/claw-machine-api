{% extends 'base.html.twig' %}
{% block title %}Statistiques — Claw Machine{% endblock %}

{% block body %}
    <style>
        .stats-page {
            min-height: 100vh;
            padding: 60px 20px;
            position: relative;
            z-index: 1;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 40px 0;
            padding: 10px 20px;
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            border-radius: 8px;
            border: 1px solid transparent;
        }

        .back-button:hover {
            color: var(--text-primary);
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.05);
        }

        .page-header {
            max-width: 900px;
            margin: 0 auto 40px;
        }

        .page-header h1 {
            font-size: 2.5em;
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .page-header p {
            color: var(--text-secondary);
            font-size: 1em;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 24px;
            max-width: 900px;
            margin: 0 auto;
        }

        .stat-card {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.15);
            border-radius: 12px;
            padding: 28px;
            transition: all 0.3s ease;
            position: relative;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 12px;
            padding: 1px;
            background: linear-gradient(135deg, var(--stat-color, #8b5cf6), rgba(255, 255, 255, 0.1));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .stat-card:hover::before {
            opacity: 1;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: var(--stat-color, rgba(139, 92, 246, 0.3));
        }

        .stat-card:nth-child(1) {
            --stat-color: #8b5cf6;
        }

        .stat-card:nth-child(2) {
            --stat-color: #ec4899;
        }

        .stat-card:nth-child(3) {
            --stat-color: #3b82f6;
        }

        .stat-card:nth-child(4) {
            --stat-color: #06b6d4;
        }

        .stat-label {
            font-size: 0.85em;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
            font-weight: 500;
        }

        .stat-value {
            font-size: 2.5em;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1;
            margin-bottom: 8px;
        }

        .stat-unit {
            font-size: 0.4em;
            color: var(--text-muted);
            font-weight: 400;
            margin-left: 4px;
        }

        .stat-desc {
            font-size: 0.9em;
            color: var(--text-muted);
        }

        .no-data {
            text-align: center;
            padding: 80px 20px;
            color: var(--text-muted);
            max-width: 900px;
            margin: 0 auto;
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.15);
            border-radius: 12px;
        }

        @media (max-width: 768px) {
            .page-header h1 {
                font-size: 2em;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="stats-page">
        <div class="page-header">
            <a href="/" class="back-button">← Retour</a>
            <h1>Statistiques</h1>
            <p>Vue d'ensemble des données globales</p>
        </div>

        {% if stats %}
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Total de parties</div>
                    <div class="stat-value">{{ stats.totalGames }}</div>
                    <div class="stat-desc">Parties jouées</div>
                </div>

                <div class="stat-card">
                    <div class="stat-label">Durée moyenne</div>
                    <div class="stat-value">
                        {{ stats.averageDuration }}
                        <span class="stat-unit">sec</span>
                    </div>
                    <div class="stat-desc">Par partie</div>
                </div>

                <div class="stat-card">
                    <div class="stat-label">Meilleur score</div>
                    <div class="stat-value">{{ stats.highestScore }}</div>
                    <div class="stat-desc">Record absolu</div>
                </div>

                <div class="stat-card">
                    <div class="stat-label">Dernière update</div>
                    <div class="stat-value" style="font-size: 1.3em;">
                        {{ stats.lastUpdated ? stats.lastUpdated|date('d/m/Y') : '—' }}
                    </div>
                    <div class="stat-desc">{{ stats.lastUpdated ? stats.lastUpdated|date('H:i') : '' }}</div>
                </div>
            </div>
        {% else %}
            <div class="no-data">
                Aucune donnée statistique disponible pour le moment
            </div>
        {% endif %}
    </div>
{% endblock %}
