{% extends 'base.html.twig' %}
{% block title %}Statistiques — OVERLOAD{% endblock %}

{% block body %}
    <style>
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 40px 0;
            padding: 10px 20px;
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            border-radius: 8px;
            border: 1px solid transparent;
        }

        .back-button:hover {
            color: var(--text-primary);
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.05);
        }

        .page-header {
            margin-bottom: 40px;
        }

        .page-header h1 {
            font-size: 2.5em;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .page-header p {
            color: var(--text-secondary);
            font-size: 1em;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 24px;
            transition: all 0.3s ease;
            position: relative;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 12px;
            padding: 1px;
            background: linear-gradient(135deg, var(--stat-color, #8b5cf6), rgba(255, 255, 255, 0.1));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .stat-card:hover::before {
            opacity: 1;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: var(--stat-color);
            box-shadow: 0 0 15px rgba(139, 92, 246, 0.2);
        }

        .stat-card:nth-child(1) { --stat-color: #8b5cf6; }
        .stat-card:nth-child(2) { --stat-color: #ec4899; }
        .stat-card:nth-child(3) { --stat-color: #3b82f6; }
        .stat-card:nth-child(4) { --stat-color: #06b6d4; }
        .stat-card:nth-child(5) { --stat-color: #10b981; }
        .stat-card:nth-child(6) { --stat-color: #f59e0b; }

        .stat-label {
            font-size: 0.85em;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 2.2em;
            font-weight: 700;
            color: var(--purple);
            line-height: 1;
        }

        .stat-unit {
            font-size: 0.5em;
            color: var(--text-secondary);
            font-weight: 400;
        }

        /* Top Players Section */
        .section {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 28px;
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 1.5em;
            font-weight: 600;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        thead th {
            padding: 12px 16px;
            text-align: left;
            font-weight: 600;
            color: var(--text-secondary);
            font-size: 0.85em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        }

        tbody tr {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.2s ease;
        }

        tbody tr:hover {
            background: rgba(139, 92, 246, 0.05);
        }

        tbody tr:last-child {
            border-bottom: none;
        }

        tbody td {
            padding: 16px;
            color: var(--text-secondary);
        }

        .rank {
            font-weight: 700;
            font-size: 1.1em;
            color: var(--purple);
        }

        .rank-1 { color: #ffd700; }
        .rank-2 { color: #c0c0c0; }
        .rank-3 { color: #cd7f32; }

        .player-name {
            font-weight: 600;
            color: var(--text-primary);
        }

        .score-value {
            font-weight: 700;
            color: var(--purple);
            font-size: 1.1em;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }

        @media (max-width: 968px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 640px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            table {
                font-size: 0.9em;
            }

            thead th, tbody td {
                padding: 12px 8px;
            }
        }
    </style>

    <div class="container">
        <div class="page-header">
            <a href="{{ path('dashboard') }}" class="back-button">← Retour</a>
            <h1>Statistiques</h1>
            <p>Vue d'ensemble des données globales en temps réel</p>
        </div>

        {# Statistiques globales #}
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Parties jouées</div>
                <div class="stat-value">{{ globalStats.totalGames }}</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Meilleur score</div>
                <div class="stat-value">{{ globalStats.highestScore }}</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Score moyen</div>
                <div class="stat-value">{{ globalStats.averageScore|number_format(0) }}</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Durée moyenne</div>
                <div class="stat-value">
                    {{ globalStats.averageDuration|number_format(1) }}
                    <span class="stat-unit">sec</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Joueurs uniques</div>
                <div class="stat-value">{{ globalStats.uniquePlayers }}</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Points totaux</div>
                <div class="stat-value">{{ globalStats.totalPoints|number_format(0, '', ' ') }}</div>
            </div>
        </div>

        {# Statistiques du jour #}
        {% if todayStats.gamesToday > 0 %}
            <div class="section">
                <h2 class="section-title">Aujourd'hui</h2>
                <div class="stats-grid" style="grid-template-columns: repeat(2, 1fr);">
                    <div>
                        <div class="stat-label">Parties jouées</div>
                        <div class="stat-value" style="font-size: 1.8em;">{{ todayStats.gamesToday }}</div>
                    </div>
                    <div>
                        <div class="stat-label">Meilleur score</div>
                        <div class="stat-value" style="font-size: 1.8em;">{{ todayStats.bestScoreToday }}</div>
                    </div>
                </div>
            </div>
        {% endif %}

        {# Top 10 des joueurs #}
        <div class="section">
            <h2 class="section-title">Classement Top 10</h2>

            {% if topPlayers|length > 0 %}
                <table>
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Joueur</th>
                            <th style="text-align: right;">Score</th>
                            <th style="text-align: right;">Durée</th>
                            <th style="text-align: right;">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for player in topPlayers %}
                            <tr>
                                <td>
                                    <span class="rank rank-{{ loop.index <= 3 ? loop.index : '' }}">
                                        {{ loop.index }}
                                    </span>
                                </td>
                                <td>
                                    <span class="player-name">{{ player.playerName }}</span>
                                </td>
                                <td style="text-align: right;">
                                    <span class="score-value">{{ player.score }}</span>
                                </td>
                                <td style="text-align: right;">
                                    {{ player.duration|number_format(1) }}s
                                </td>
                                <td style="text-align: right;">
                                    {{ player.playedAt|date('d/m/Y H:i') }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="empty-state">
                    <p>Aucun score enregistré</p>
                    <p style="font-size: 0.9em; margin-top: 8px;">Les joueurs apparaîtront ici après leurs premières parties</p>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
