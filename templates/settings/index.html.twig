{% extends 'base.html.twig' %}
{% block title %}Parametres - OVERLOAD{% endblock %}

{% block body %}
    <style>
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 40px 0;
            padding: 10px 20px;
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            border-radius: 8px;
            border: 1px solid transparent;
        }

        .back-button:hover {
            color: var(--text-primary);
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.05);
        }

        .page-header {
            margin-bottom: 40px;
        }

        .page-header h1 {
            font-size: 2.5em;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .page-header p {
            color: var(--text-secondary);
            font-size: 1em;
        }

        .settings-container {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 32px;
        }

        .flash-message {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 24px;
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid var(--cyan);
            color: var(--cyan);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .flash-message::before {
            content: 'V';
            font-size: 1.2em;
            font-weight: 700;
        }

        .section-header {
            margin: 32px 0 20px 0;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.3);
        }

        .section-header:first-of-type {
            margin-top: 0;
        }

        .section-header h3 {
            font-size: 1.2em;
            font-weight: 600;
            color: var(--purple);
            margin: 0 0 4px 0;
        }

        .section-desc {
            font-size: 0.85em;
            color: var(--text-muted);
            margin: 0;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .form-row {
            margin-bottom: 0;
        }

        .form-row.full-width {
            grid-column: 1 / -1;
        }

        .form-row label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-primary);
            font-size: 0.85em;
            font-weight: 600;
        }

        .form-row input[type="number"],
        .form-row select {
            width: 100%;
            background: rgba(15, 15, 25, 0.4);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 10px 14px;
            font-size: 0.95em;
            transition: all 0.3s ease;
        }

        .form-row input:focus,
        .form-row select:focus {
            outline: none;
            border-color: var(--purple);
            box-shadow: var(--glow-purple);
        }

        .help-text {
            margin-top: 4px;
            font-size: 0.75em;
            color: var(--text-muted);
            line-height: 1.3;
        }

        .current-value {
            display: inline-block;
            margin-left: 8px;
            padding: 2px 6px;
            background: rgba(139, 92, 246, 0.2);
            border-radius: 4px;
            font-size: 0.75em;
            color: var(--purple);
            font-weight: 600;
        }

        .submit-btn {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.1));
            border: 1px solid rgba(139, 92, 246, 0.5);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 14px 32px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 32px;
        }

        .submit-btn:hover {
            border-color: var(--purple);
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), rgba(236, 72, 153, 0.2));
            box-shadow: var(--glow-purple);
            transform: translateY(-1px);
        }

        @media (max-width: 768px) {
            .page-header h1 {
                font-size: 2em;
            }

            .settings-container {
                padding: 24px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="container">
        <div class="page-header">
            <a href="{{ path('dashboard') }}" class="back-button">&larr; Retour</a>
            <h1>Parametres du jeu</h1>
            <p>Configurez les reglages de spawn des peluches et tokens</p>
        </div>

        <div class="settings-container">
            {% for message in app.flashes('success') %}
                <div class="flash-message">{{ message }}</div>
            {% endfor %}

            {{ form_start(form) }}

            {# ===== GENERAL ===== #}
            <div class="section-header">
                <h3>General</h3>
                <p class="section-desc">Parametres globaux de la partie</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.timeLimit) }}
                    <span class="current-value">{{ settings.timeLimit }}s</span>
                    {{ form_widget(form.timeLimit) }}
                    {{ form_help(form.timeLimit) }}
                </div>
            </div>

            {# ===== TOKENS - ENERGY ===== #}
            <div class="section-header">
                <h3>Energy Tokens</h3>
                <p class="section-desc">Jetons qui rechargent la jauge d'energie du joueur</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.energyTokenProbability) }}
                    <span class="current-value">{{ settings.energyTokenProbability }}%</span>
                    {{ form_widget(form.energyTokenProbability) }}
                    {{ form_help(form.energyTokenProbability) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.minEnergyTokens) }}
                    <span class="current-value">{{ settings.minEnergyTokens }}</span>
                    {{ form_widget(form.minEnergyTokens) }}
                    {{ form_help(form.minEnergyTokens) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.maxEnergyTokens) }}
                    <span class="current-value">{{ settings.maxEnergyTokens }}</span>
                    {{ form_widget(form.maxEnergyTokens) }}
                    {{ form_help(form.maxEnergyTokens) }}
                </div>
            </div>

            {# ===== TOKENS - BOMB ===== #}
            <div class="section-header">
                <h3>Bomb Tokens</h3>
                <p class="section-desc">Jetons explosifs qui detruisent les peluches autour</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.bombTokenProbability) }}
                    <span class="current-value">{{ settings.bombTokenProbability }}%</span>
                    {{ form_widget(form.bombTokenProbability) }}
                    {{ form_help(form.bombTokenProbability) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.minBombTokens) }}
                    <span class="current-value">{{ settings.minBombTokens }}</span>
                    {{ form_widget(form.minBombTokens) }}
                    {{ form_help(form.minBombTokens) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.maxBombTokens) }}
                    <span class="current-value">{{ settings.maxBombTokens }}</span>
                    {{ form_widget(form.maxBombTokens) }}
                    {{ form_help(form.maxBombTokens) }}
                </div>
            </div>

            {# ===== TOKENS - BLACKOUT ===== #}
            <div class="section-header">
                <h3>Blackout Tokens</h3>
                <p class="section-desc">Jetons qui activent le mode blackout (multiplicateur de points x2)</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.blackoutTokenProbability) }}
                    <span class="current-value">{{ settings.blackoutTokenProbability }}%</span>
                    {{ form_widget(form.blackoutTokenProbability) }}
                    {{ form_help(form.blackoutTokenProbability) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.minBlackoutTokens) }}
                    <span class="current-value">{{ settings.minBlackoutTokens }}</span>
                    {{ form_widget(form.minBlackoutTokens) }}
                    {{ form_help(form.minBlackoutTokens) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.maxBlackoutTokens) }}
                    <span class="current-value">{{ settings.maxBlackoutTokens }}</span>
                    {{ form_widget(form.maxBlackoutTokens) }}
                    {{ form_help(form.maxBlackoutTokens) }}
                </div>
            </div>

            {# ===== PELUCHES - QUANTITES ===== #}
            <div class="section-header">
                <h3>Peluches - Quantites</h3>
                <p class="section-desc">Controle le nombre de peluches dans le bac et le respawn</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.initialPlushieCount) }}
                    <span class="current-value">{{ settings.initialPlushieCount }}</span>
                    {{ form_widget(form.initialPlushieCount) }}
                    {{ form_help(form.initialPlushieCount) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.minPlushiesBeforeRespawn) }}
                    <span class="current-value">{{ settings.minPlushiesBeforeRespawn }}</span>
                    {{ form_widget(form.minPlushiesBeforeRespawn) }}
                    {{ form_help(form.minPlushiesBeforeRespawn) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.maxPlushiesInBin) }}
                    <span class="current-value">{{ settings.maxPlushiesInBin }}</span>
                    {{ form_widget(form.maxPlushiesInBin) }}
                    {{ form_help(form.maxPlushiesInBin) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.plushiesPerSpawn) }}
                    <span class="current-value">{{ settings.plushiesPerSpawn }}</span>
                    {{ form_widget(form.plushiesPerSpawn) }}
                    {{ form_help(form.plushiesPerSpawn) }}
                </div>
            </div>

            {# ===== PELUCHES - RARETES ===== #}
            <div class="section-header">
                <h3>Peluches - Raretes</h3>
                <p class="section-desc">Probabilites d'apparition selon la rarete (le total doit faire 100%)</p>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    {{ form_label(form.commonProbability) }}
                    <span class="current-value">{{ settings.commonProbability }}%</span>
                    {{ form_widget(form.commonProbability) }}
                    {{ form_help(form.commonProbability) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.rareProbability) }}
                    <span class="current-value">{{ settings.rareProbability }}%</span>
                    {{ form_widget(form.rareProbability) }}
                    {{ form_help(form.rareProbability) }}
                </div>
            </div>

            {{ form_widget(form.save, {'attr': {'class': 'submit-btn'}}) }}

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
