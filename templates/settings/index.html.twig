{% extends 'base.html.twig' %}
{% block title %}Paramètres — Claw Machine{% endblock %}

{% block body %}
    <style>
        .settings-page {
            min-height: 100vh;
            padding: 60px 20px;
            position: relative;
            z-index: 1;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 40px 0;
            padding: 10px 20px;
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            border-radius: 8px;
            border: 1px solid transparent;
        }

        .back-button:hover {
            color: var(--text-primary);
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.05);
        }

        .page-header {
            max-width: 700px;
            margin: 0 auto 40px;
        }

        .page-header h1 {
            font-size: 2.5em;
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .page-header p {
            color: var(--text-secondary);
            font-size: 1em;
        }

        .settings-container {
            max-width: 700px;
            margin: 0 auto;
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.15);
            border-radius: 12px;
            padding: 32px;
        }

        .flash-message {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 24px;
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid var(--cyan);
            color: var(--cyan);
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-secondary);
            font-size: 0.9em;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            background: rgba(15, 15, 25, 0.4);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 12px 16px;
            font-size: 0.95em;
            transition: all 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--purple);
            box-shadow: var(--glow-purple);
        }

        .submit-btn {
            background: transparent;
            border: 1px solid rgba(139, 92, 246, 0.5);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 14px 32px;
            font-size: 0.95em;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 8px;
        }

        .submit-btn:hover {
            border-color: var(--purple);
            background: rgba(139, 92, 246, 0.1);
            box-shadow: var(--glow-purple);
        }

        @media (max-width: 768px) {
            .page-header h1 {
                font-size: 2em;
            }

            .settings-container {
                padding: 24px;
            }
        }
    </style>

    <div class="settings-page">
        <div class="page-header">
            <a href="/" class="back-button">← Retour</a>
            <h1>Paramètres</h1>
            <p>Configuration du système de jeu</p>
        </div>

        <div class="settings-container">
            {% for message in app.flashes('success') %}
                <div class="flash-message">{{ message }}</div>
            {% endfor %}

            {{ form_start(form) }}

            <div class="form-group">
                {{ form_label(form.timeLimit, 'Temps limite') }}
                {{ form_widget(form.timeLimit, {'attr': {'placeholder': 'Secondes'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.clawSpeed, 'Vitesse griffe') }}
                {{ form_widget(form.clawSpeed, {'attr': {'placeholder': '1-10'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.difficulty, 'Difficulté') }}
                {{ form_widget(form.difficulty) }}
            </div>

            <div class="form-group">
                {{ form_label(form.itemSpawnRate, 'Taux apparition') }}
                {{ form_widget(form.itemSpawnRate, {'attr': {'placeholder': '0-100'}}) }}
            </div>

            {{ form_widget(form.save, {'attr': {'class': 'submit-btn'}, 'label': 'Sauvegarder'}) }}

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
