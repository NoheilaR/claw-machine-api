{% extends 'base.html.twig' %}

{% block title %}Paramètres — Claw Machine{% endblock %}

{% block body %}
    <style>
        body { font-family: 'Inter', sans-serif; background: #121212; color: #e0e0e0; margin: 0; min-height: 100vh; }
        h1 { text-align: center; margin: 50px 0; font-size: 2em; }
        .container { max-width: 600px; margin: 0 auto; background: #1e1e1e; padding: 30px; border-radius: 10px; border: 1px solid #2a2a2a; }
        .form-group { margin-bottom: 20px; }
        label { display: block; margin-bottom: 8px; color: #bbb; }
        input, select { width: 100%; padding: 10px; background: #2a2a2a; border: 1px solid #444; border-radius: 6px; color: #fff; }
        button { background: #4a9eff; color: white; border: none; padding: 12px 20px; border-radius: 6px; cursor: pointer; font-weight: 600; }
        button:hover { background: #357abd; }
        .back { display: inline-block; margin: 30px 40px; color: #aaa; text-decoration: none; }
        .back:hover { color: #fff; }
        .flash { padding: 15px; margin: 20px 0; border-radius: 6px; background: #2d5016; color: #a8e6a1; }
    </style>

    <a href="/" class="back">← Retour au Dashboard</a>
    <h1>Paramètres du Jeu</h1>

    <div class="container">
        {% for message in app.flashes('success') %}
            <div class="flash">{{ message }}</div>
        {% endfor %}

        {{ form_start(form) }}
        <div class="form-group">
            {{ form_label(form.timeLimit) }}
            {{ form_widget(form.timeLimit) }}
        </div>
        <div class="form-group">
            {{ form_label(form.clawSpeed) }}
            {{ form_widget(form.clawSpeed) }}
        </div>
        <div class="form-group">
            {{ form_label(form.difficulty) }}
            {{ form_widget(form.difficulty) }}
        </div>
        <div class="form-group">
            {{ form_label(form.itemSpawnRate) }}
            {{ form_widget(form.itemSpawnRate) }}
        </div>
        {{ form_row(form.save) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
