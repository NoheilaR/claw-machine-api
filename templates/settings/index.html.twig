{% extends 'base.html.twig' %}
{% block title %}Paramètres — Claw Machine{% endblock %}

{% block body %}
    <style>
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 40px 0;
            padding: 10px 20px;
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            border-radius: 8px;
            border: 1px solid transparent;
        }

        .back-button:hover {
            color: var(--text-primary);
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.05);
        }

        .page-header {
            margin-bottom: 40px;
        }

        .page-header h1 {
            font-size: 2.5em;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .page-header p {
            color: var(--text-secondary);
            font-size: 1em;
        }

        .settings-container {
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 32px;
        }

        .flash-message {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 24px;
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid var(--cyan);
            color: var(--cyan);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .flash-message::before {
            content: '✓';
            font-size: 1.2em;
            font-weight: 700;
        }

        .form-row {
            margin-bottom: 28px;
        }

        .form-row label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-primary);
            font-size: 0.95em;
            font-weight: 600;
        }

        .form-row input[type="number"],
        .form-row select {
            width: 100%;
            background: rgba(15, 15, 25, 0.4);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 12px 16px;
            font-size: 1em;
            transition: all 0.3s ease;
        }

        .form-row input:focus,
        .form-row select:focus {
            outline: none;
            border-color: var(--purple);
            box-shadow: var(--glow-purple);
        }

        .help-text {
            margin-top: 6px;
            font-size: 0.85em;
            color: var(--text-muted);
            line-height: 1.4;
        }

        .current-value {
            display: inline-block;
            margin-left: 8px;
            padding: 2px 8px;
            background: rgba(139, 92, 246, 0.2);
            border-radius: 4px;
            font-size: 0.85em;
            color: var(--purple);
            font-weight: 600;
        }

        .submit-btn {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.1));
            border: 1px solid rgba(139, 92, 246, 0.5);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 14px 32px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 16px;
        }

        .submit-btn:hover {
            border-color: var(--purple);
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), rgba(236, 72, 153, 0.2));
            box-shadow: var(--glow-purple);
            transform: translateY(-1px);
        }

        .presets {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 32px;
            padding: 20px;
            background: rgba(139, 92, 246, 0.05);
            border-radius: 8px;
            border: 1px solid rgba(139, 92, 246, 0.1);
        }

        .preset-card {
            text-align: center;
            padding: 16px 12px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .preset-card:hover {
            border-color: var(--purple);
            background: rgba(139, 92, 246, 0.1);
        }

        .preset-title {
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .preset-desc {
            font-size: 0.8em;
            color: var(--text-muted);
        }

        @media (max-width: 768px) {
            .page-header h1 {
                font-size: 2em;
            }

            .settings-container {
                padding: 24px;
            }

            .presets {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="container">
        <div class="page-header">
            <a href="/" class="back-button">← Retour</a>
            <h1>Paramètres du jeu</h1>
            <p>Configurez les réglages de gameplay</p>
        </div>

        <div class="settings-container">
            {% for message in app.flashes('success') %}
                <div class="flash-message">{{ message }}</div>
            {% endfor %}

            <div class="presets">
                <div class="preset-card" onclick="applyPreset('easy')">
                    <div class="preset-title">Facile</div>
                    <div class="preset-desc">Pour débutants</div>
                </div>
                <div class="preset-card" onclick="applyPreset('medium')">
                    <div class="preset-title">Moyen</div>
                    <div class="preset-desc">Équilibré</div>
                </div>
                <div class="preset-card" onclick="applyPreset('hard')">
                    <div class="preset-title">Difficile</div>
                    <div class="preset-desc">Pour experts</div>
                </div>
            </div>

            {{ form_start(form) }}

            <div class="form-row">
                {{ form_label(form.clawSpeed) }}
                <span class="current-value">Actuel: {{ settings.clawSpeed }}</span>
                {{ form_widget(form.clawSpeed) }}
                {{ form_help(form.clawSpeed) }}
            </div>

            <div class="form-row">
                {{ form_label(form.timeLimit) }}
                <span class="current-value">Actuel: {{ settings.timeLimit }}s</span>
                {{ form_widget(form.timeLimit) }}
                {{ form_help(form.timeLimit) }}
            </div>

            <div class="form-row">
                {{ form_label(form.difficulty) }}
                <span class="current-value">Actuel: {{ settings.difficulty }}</span>
                {{ form_widget(form.difficulty) }}
                {{ form_help(form.difficulty) }}
            </div>

            <div class="form-row">
                {{ form_label(form.itemSpawnRate) }}
                <span class="current-value">Actuel: {{ settings.itemSpawnRate }}</span>
                {{ form_widget(form.itemSpawnRate) }}
                {{ form_help(form.itemSpawnRate) }}
            </div>

            {{ form_widget(form.save, {'attr': {'class': 'submit-btn'}}) }}

            {{ form_end(form) }}
        </div>
    </div>

    <script>
        function applyPreset(preset) {
            const clawSpeedInput = document.querySelector('#game_settings_clawSpeed');
            const timeLimitInput = document.querySelector('#game_settings_timeLimit');
            const difficultySelect = document.querySelector('#game_settings_difficulty');
            const itemSpawnRateInput = document.querySelector('#game_settings_itemSpawnRate');

            const presets = {
                easy: {
                    clawSpeed: 7.0,
                    timeLimit: 90,
                    difficulty: 'Easy',
                    itemSpawnRate: 4.0
                },
                medium: {
                    clawSpeed: 5.0,
                    timeLimit: 60,
                    difficulty: 'Medium',
                    itemSpawnRate: 2.5
                },
                hard: {
                    clawSpeed: 3.0,
                    timeLimit: 45,
                    difficulty: 'Hard',
                    itemSpawnRate: 1.5
                }
            };

            const config = presets[preset];
            if (config) {
                clawSpeedInput.value = config.clawSpeed;
                timeLimitInput.value = config.timeLimit;
                difficultySelect.value = config.difficulty;
                itemSpawnRateInput.value = config.itemSpawnRate;

                // Animation flash
                [clawSpeedInput, timeLimitInput, difficultySelect, itemSpawnRateInput].forEach(input => {
                    input.style.borderColor = 'var(--purple)';
                    input.style.boxShadow = 'var(--glow-purple)';
                    setTimeout(() => {
                        input.style.borderColor = '';
                        input.style.boxShadow = '';
                    }, 500);
                });
            }
        }
    </script>
{% endblock %}
